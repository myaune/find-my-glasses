    "licenses_intro": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is built with the open-source software below. Its source code is public under the AGPL-3.0 license."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱은 아래 오픈소스 소프트웨어로 만들어졌습니다. 앱의 소스 코드는 AGPL-3.0 라이선스로 공개됩니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリは以下のオープンソースソフトウェアで作られています。アプリのソースコードはAGPL-3.0ライセンスで公開されています。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta app usa el software de código abierto que aparece abajo. Su código fuente se publica bajo la licencia AGPL-3.0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用使用了下列开源软件。应用源代码以 AGPL-3.0 许可证公开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用程式使用以下開放原始碼軟體。本應用程式的原始碼以 AGPL-3.0 授權公開。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este app usa o software de código aberto abaixo. O código-fonte é público sob a licença AGPL-3.0."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette application utilise les logiciels open source ci-dessous. Son code source est public sous licence AGPL-3.0."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App verwendet die folgende Open-Source-Software. Ihr Quellcode ist unter der AGPL-3.0-Lizenz öffentlich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa app usa il software open source elencato qui sotto. Il suo codice sorgente è pubblico con licenza AGPL-3.0."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение использует открытое ПО, указанное ниже. Исходный код приложения открыт под лицензией AGPL-3.0."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama aşağıdaki açık kaynak yazılımları kullanır. Uygulamanın kaynak kodu AGPL-3.0 lisansıyla herkese açıktır."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم هذا التطبيق البرمجيات مفتوحة المصدر أدناه. شيفرة التطبيق المصدرية متاحة للعموم بترخيص AGPL-3.0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप नीचे दिए गए ओपन-सोर्स सॉफ़्टवेयर से बना है। ऐप का सोर्स कोड AGPL-3.0 लाइसेंस के तहत सार्वजनिक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi ini memakai perangkat lunak sumber terbuka di bawah. Kode sumber aplikasi ini terbuka dengan lisensi AGPL-3.0."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ứng dụng này dùng các phần mềm mã nguồn mở dưới đây. Mã nguồn của ứng dụng được công khai theo giấy phép AGPL-3.0."
          }
        },
        "th": {
