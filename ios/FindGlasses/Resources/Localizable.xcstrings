    "tut_step1_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Point your phone at where you think you left them and move it slowly."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안경을 둔 것 같은 곳을 향해 폰을 천천히 움직여주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メガネを置いたと思う場所にスマホを向けて、ゆっくり動かしてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apunta el teléfono hacia donde crees que las dejaste y muévelo despacio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把手机对准你觉得放眼镜的地方，慢慢移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把手機對準你覺得放眼鏡的地方，慢慢移動。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aponte o celular para onde você acha que deixou os óculos e mova devagar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointez le téléphone vers l’endroit où vous pensez les avoir laissées et déplacez-le lentement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richte dein Handy dorthin, wo du die Brille vermutest, und bewege es langsam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Punta il telefono dove pensi di averli lasciati e muovilo lentamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Направьте телефон туда, где, как вам кажется, лежат очки, и медленно ведите его."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Telefonu gözlüğü bıraktığını düşündüğün yere doğru tut ve yavaşça hareket ettir."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وجّه الهاتف نحو المكان الذي تظن أنك تركت فيه النظارة وحرّكه ببطء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ोन को उस जगह की ओर करें जहाँ आपको लगता है कि चश्मा रखा था, और धीरे-धीरे घुमाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan ponsel ke tempat yang kamu kira kacamatanya ada, lalu gerakkan pelan-pelan."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hướng điện thoại về nơi bạn nghĩ đã để kính và di chuyển thật chậm."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หันโทรศัพท์ไปยังที่ที่คิดว่าวางแว่นไว้ แล้วค่อยๆ ขยับ"
          }
        }
      }
    },
    "tut_step1_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look around slowly"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "천천히 둘러봐주세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゆっくり見回してください"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira alrededor despacio"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢环顾四周"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "慢慢環顧四周"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Olhe ao redor devagar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regardez lentement"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsam umschauen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardati intorno lentamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленно осмотритесь"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yavaşça etrafına bak"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انظر حولك ببطء"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "धीरे-धीरे आसपास देखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat sekeliling pelan-pelan"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhìn quanh thật chậm"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ค่อยๆ มองไปรอบๆ"
          }
        }
      }
    },
    "tut_step2_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When we spot glasses, a box and arrows point to them. The color turns from yellow to green as we get more sure."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안경이 보이면 네모와 화살표로 가리켜요. 확실할수록 색이 노랑 → 연두 → 초록으로 바뀌어요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メガネが見えたら枠と矢印で示します。確かなほど色が黄→黄緑→緑に変わります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando vemos unas gafas, un recuadro y flechas las señalan. El color pasa de amarillo a verde cuanto más seguros estamos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "看到眼镜时会用方框和箭头指出来。越确定，颜色越从黄变成绿。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "看到眼鏡時會用方框和箭頭指出來。越確定，顏色越從黃色變成綠色。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando vemos óculos, um quadro e setas apontam para eles. Quanto mais certeza, mais a cor muda de amarelo para verde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand on repère des lunettes, un cadre et des flèches les montrent. Plus on est sûr, plus la couleur passe du jaune au vert."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sehen wir eine Brille, zeigen ein Rahmen und Pfeile darauf. Je sicherer wir sind, desto mehr wechselt die Farbe von Gelb zu Grün."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando vediamo degli occhiali, un riquadro e delle frecce li indicano. Più siamo sicuri, più il colore passa dal giallo al verde."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда мы видим очки, рамка и стрелки указывают на них. Чем увереннее, тем больше цвет меняется с жёлтого на зелёный."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlük gördüğümüzde bir çerçeve ve oklar onu gösterir. Ne kadar eminsek renk o kadar sarıdan yeşile döner."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما نرى نظارة، يشير إليها إطار وأسهم. كلما زاد تأكدنا تغيّر اللون من الأصفر إلى الأخضر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चश्मा दिखने पर एक फ्रेम और तीर उसकी ओर इशारा करते हैं। जितना ज़्यादा भरोसा, रंग उतना पीले से हरा होता जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat kacamata terlihat, kotak dan panah akan menunjuknya. Makin yakin, warnanya makin berubah dari kuning ke hijau."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi thấy kính, một khung và các mũi tên sẽ chỉ vào đó. Càng chắc chắn, màu càng chuyển từ vàng sang xanh lá."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเห็นแว่น กรอบและลูกศรจะชี้ไปที่แว่น ยิ่งมั่นใจ สีจะยิ่งเปลี่ยนจากเหลืองเป็นเขียว"
          }
        }
      }
    },
    "tut_step2_title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "We'll show you where"
          }
        },
        "ko": {
