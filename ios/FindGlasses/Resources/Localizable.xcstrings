            "value": "Kami tunjukkan tempatnya"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi chỉ chỗ cho bạn"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะชี้ให้ดู"
          }
        }
      }
    },
    "tut_step3_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glasses stand out on plain surfaces. On busy or similar-colored surfaces, move a bit closer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단색 바닥이나 책상 위에서는 잘 보여요. 무늬가 복잡하거나 안경과 색이 비슷한 곳에서는 조금 더 가까이 가주세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "無地の床や机の上ではよく見つかります。柄が多い所やメガネと似た色の所では、少し近づいてください。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ven bien sobre superficies lisas. Sobre estampados o colores parecidos, acércate un poco más."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在纯色的地面或桌面上容易找到。在花纹复杂或颜色和眼镜相近的地方，请再靠近一点。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在素色的地面或桌面上容易找到。在花紋複雜或顏色和眼鏡相近的地方，請再靠近一點。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os óculos aparecem bem em superfícies lisas. Em estampas ou cores parecidas, chegue um pouco mais perto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les lunettes se voient bien sur une surface unie. Sur un motif chargé ou une couleur proche, approchez-vous un peu."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einfarbigen Flächen ist die Brille gut zu sehen. Auf gemusterten oder ähnlich farbigen Flächen geh etwas näher heran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli occhiali si vedono bene su superfici a tinta unita. Su fantasie o colori simili, avvicinati un po’."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На однотонной поверхности очки видно хорошо. На пёстрой или похожей по цвету подойдите чуть ближе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz renkli yüzeylerde gözlük kolay görünür. Desenli ya da benzer renkli yüzeylerde biraz daha yaklaş."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر النظارة بسهولة على الأسطح السادة. على الأسطح المزخرفة أو ذات اللون المشابه، اقترب قليلاً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सादी सतह पर चश्मा आसानी से दिखता है। डिज़ाइन वाली या मिलते-जुलते रंग की सतह पर थोड़ा पास जाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kacamata mudah terlihat di permukaan polos. Di permukaan bermotif atau berwarna mirip, dekatkan sedikit lagi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kính dễ thấy trên bề mặt một màu. Trên bề mặt nhiều hoa văn hoặc cùng màu, hãy lại gần hơn một chút."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนพื้นผิวสีเรียบจะเห็นแว่นได้ง่าย ถ้าพื้นมีลวดลายหรือสีคล้ายแว่น ให้เข้าไปใกล้อีกนิด"
          }
        }
      }
    },
