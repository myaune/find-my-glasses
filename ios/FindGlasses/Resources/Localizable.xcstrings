    "support_body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A one-time purchase removes all ads. It also supports the developer."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 구매하면 광고가 모두 사라져요. 개발자에게도 작은 응원이 돼요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一度の購入で広告がすべて消えます。開発者の応援にもなります。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una compra única quita todos los anuncios. También apoya al desarrollador."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次购买即可去除所有广告，也算是对开发者的一点支持。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一次購買即可移除所有廣告，也算是對開發者的一點支持。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma compra única remove todos os anúncios. Também apoia o desenvolvedor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un achat unique retire toutes les pubs. Il soutient aussi le développeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein einmaliger Kauf entfernt alle Werbung und unterstützt auch den Entwickler."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un acquisto unico rimuove tutta la pubblicità e sostiene anche lo sviluppatore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка убирает всю рекламу и немного поддерживает разработчика."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek seferlik satın alma tüm reklamları kaldırır ve geliştiriciye de destek olur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شراء لمرة واحدة يزيل كل الإعلانات، وهو أيضاً دعم للمطوّر."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार की खरीद से सारे विज्ञापन हट जाते हैं। इससे डेवलपर का भी साथ होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sekali beli, semua iklan hilang. Sekaligus mendukung pengembang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mua một lần là gỡ hết quảng cáo, đồng thời ủng hộ nhà phát triển."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ซื้อครั้งเดียวโฆษณาจะหายไปทั้งหมด และเป็นการสนับสนุนนักพัฒนาด้วย"
          }
        }
      }
    },
