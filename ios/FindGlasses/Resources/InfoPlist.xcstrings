{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find My Glasses"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 안경 찾기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メガネ探し"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar gafas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找眼镜"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "找眼鏡"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Achar meus óculos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouver mes lunettes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Brille finden"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova occhiali"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Найти очки"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gözlüğümü Bul"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ابحث عن نظارتي"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चश्मा ढूंढें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cari Kacamata"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kính"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หาแว่นตา"
          }
        }
      }
    },
    "NSCameraUsageDescription": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used to find your glasses. Video is processed only on this device and never leaves it."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "안경을 찾기 위해 카메라를 사용해요. 영상은 기기 안에서만 처리되고 밖으로 나가지 않아요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メガネを探すためにカメラを使います。映像はこの端末の中だけで処理され、外部に送られません。"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara se usa para encontrar tus gafas. El vídeo se procesa solo en este dispositivo y nunca sale de él."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相机来寻找你的眼镜。画面只在本机处理，不会上传。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用相機來尋找你的眼鏡。畫面只在本機處理，不會上傳。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera é usada para achar seus óculos. O vídeo é processado só neste aparelho e nunca sai dele."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra sert à trouver vos lunettes. La vidéo est traitée uniquement sur cet appareil et n’en sort jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird genutzt, um deine Brille zu finden. Das Video wird nur auf diesem Gerät verarbeitet und verlässt es nie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera serve a trovare i tuoi occhiali. Il video viene elaborato solo su questo dispositivo e non esce mai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера нужна, чтобы найти очки. Видео обрабатывается только на этом устройстве и никуда не передаётся."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera gözlüğünü bulmak için kullanılır. Görüntü yalnızca bu cihazda işlenir ve dışarı gönderilmez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم الكاميرا للعثور على نظارتك. تتم معالجة الفيديو على هذا الجهاز فقط ولا يغادره أبداً."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका चश्मा ढूंढने के लिए कैमरा इस्तेमाल होता है। वीडियो सिर्फ़ इसी डिवाइस पर प्रोसेस होता है और बाहर नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera dipakai untuk mencari kacamatamu. Video hanya diproses di perangkat ini dan tidak pernah dikirim keluar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Camera được dùng để tìm kính của bạn. Video chỉ được xử lý trên thiết bị này và không bao giờ gửi ra ngoài."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กล้องเพื่อหาแว่นของคุณ วิดีโอประมวลผลในเครื่องนี้เท่านั้นและไม่ถูกส่งออกไป"
          }
        }
      }
    }
  },
  "version": "1.0"
}