<?xml version="1.0" encoding="utf-8"?>
<!-- 설정: 음성 / 진동 / 언어 / 광고 없애기. 스크롤 없이 한 화면에 들어가게 촘촘히. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="4dp"
    android:paddingBottom="12dp">

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swVoice"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:textSize="18sp"
        android:text="@string/settings_voice" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/swVibration"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:textSize="18sp"
        android:text="@string/settings_vibration" />

    <!-- [언어]            [한국어 ▾] -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="18sp"
            android:text="@string/settings_language" />

        <Spinner
            android:id="@+id/spLanguage"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/quality_pill"
            android:popupBackground="#FF202124" />
    </LinearLayout>

    <!-- 광고 없애기 (IAP). 가격은 스토어가 국가별로 준다. -->
    <LinearLayout
        android:id="@+id/supportCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="12dp"
        android:paddingBottom="4dp"
        android:background="@drawable/support_card">

        <TextView
            android:id="@+id/supportTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:text="@string/support_title" />

        <TextView
            android:id="@+id/supportBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="14sp"
            android:text="@string/support_body" />

        <Button
            android:id="@+id/btnSupport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textSize="16sp"
            android:text="@string/support_title" />

        <Button
            android:id="@+id/btnRestore"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/restore_purchases" />
    </LinearLayout>

    <!-- 개인정보처리방침 · 광고 개인정보 설정(동의 지역만) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/btnPrivacyPolicy"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:text="@string/privacy_policy" />

        <Button
            android:id="@+id/btnPrivacyOptions"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:visibility="gone"
            android:text="@string/privacy_options" />
    </LinearLayout>
</LinearLayout>
